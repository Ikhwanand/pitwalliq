# PitwallIQ Backend Environment Configuration

# OpenRouter (Recommended for free reasoning / decision models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free
OPENROUTER_DECISION_MODEL=inception/mercury-decide:free

# OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# FastF1 Settings
FASTF1_CACHE_ENABLED=true


F1_USERNAME="email_anda@example.com"
F1_PASSWORD="password_f1_anda"
